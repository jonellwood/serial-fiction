TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=
AUTH_SECRET=replace-with-at-least-32-random-characters
PUBLIC_SITE_URL=http://localhost:5173
EMAIL_FROM=Between Lines <stories@example.com>
EMAIL_PROVIDER_API_KEY=
# Local only: magic links are written to .data/mailbox.json (never logged).
DEV_MAILBOX=true
# Used only by the seed command, not an automatic role assignment at login.
ADMIN_EMAIL=author@example.test

# Optional private S3-compatible image storage. Leave unset for local development.
# Never make this bucket public. Production requires cloud storage for uploads.
IMAGE_BUCKET=
IMAGE_ENDPOINT=
IMAGE_REGION=auto
IMAGE_ACCESS_KEY_ID=
IMAGE_SECRET_ACCESS_KEY=
